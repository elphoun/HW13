SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

SLACKOFF_USER_IDS=
SLACKOFF_DAY_START_HOUR=9
SLACKOFF_DAY_END_HOUR=17
SLACKOFF_WORK_MINUTES=25
SLACKOFF_SITTING_BREAK_MINUTES=5
SLACKOFF_ACTIVE_BREAK_MINUTES=5
SLACKOFF_MOTION_UDP_PORT=9001
SLACKOFF_GIF_BASE_URL=

# Reaction GIFs after each break: happy when finished, sad when time runs out (comma-separated image URLs).
# Defaults are built in. Set SLACKOFF_REACTION_GIFS=off to disable.
# SLACKOFF_HAPPY_GIF_URLS=
# SLACKOFF_SAD_GIF_URLS=
# SLACKOFF_REACTION_GIFS=off
